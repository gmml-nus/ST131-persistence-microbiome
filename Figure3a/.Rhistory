# Function to split taxa names with more than 2 words into two lines
split_taxa_names <- function(name) {
words <- strsplit(name, " ")[[1]]
if (length(words) > 2) {
# Split into two lines: first two words on first line, rest on second line
first_line <- paste(words[1:2], collapse = " ")
second_line <- paste(words[3:length(words)], collapse = " ")
return(paste(first_line, second_line, sep = "\n"))
} else {
return(name)
}
}

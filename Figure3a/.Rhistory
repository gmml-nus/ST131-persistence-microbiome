}
}
# Function to create display names (with newlines) while keeping original names for matching
create_display_names <- function(name) {
words <- strsplit(name, " ")[[1]]
if (length(words) > 1) {
# Split into two lines: first word on first line, rest on second line
first_line <- words[1]
second_line <- paste(words[2:length(words)], collapse = " ")
return(paste(first_line, second_line, sep = "\n"))
} else {
return(name)
}
}
# Keep all taxa - only filter out rows with missing essential data
ad.tip_metadata <- ad.tip_metadata %>%
# Convert Effect to factor and remove NA levels
mutate(Effect = factor(Effect, levels = c(1, -1), labels = c("Enriched", "Depleted"))) %>%
# Convert Phyla to factor to control legend
mutate(Phyla = factor(Phyla)) %>%
# Create display names for visualization (keep original names for matching)
mutate(display_name = sapply(species_name, create_display_names))
# --- Branch coloring like tree_plot_noname.R ---
# Assign a color (phyla) to internal branches when all immediate children share the same phyla
assign_node_colors <- function(tree_data, tip_data) {
node_phyla <- rep(NA_character_, nrow(tree_data))
# assign phyla to tip nodes by matching species_name to tip label
for (i in seq_len(nrow(tree_data))) {
if (!is.na(tree_data$label[i])) {
tip_name <- tree_data$label[i]
idx <- which(tip_data$species_name == tip_name)
if (length(idx) > 0) node_phyla[i] <- as.character(tip_data$Phyla[idx[1]])
}
}
# propagate phyla upward when all direct children match
for (iter in 1:10) {
changed <- FALSE
for (i in seq_len(nrow(tree_data))) {
if (is.na(node_phyla[i])) {
children_idx <- which(tree_data$parent == tree_data$node[i])
if (length(children_idx) > 0) {
child_vals <- node_phyla[children_idx]
child_vals <- child_vals[!is.na(child_vals)]
if (length(child_vals) > 0) {
uniq <- unique(child_vals)
if (length(uniq) == 1) {
node_phyla[i] <- uniq[1]
changed <- TRUE
}
}
}
}
}
if (!changed) break
}
return(node_phyla)
}
# Build base tree and merge metadata
ptree.ad <- ggtree(ad.tree, layout = "circular")
ptree.ad <- ptree.ad %<+% ad.tip_metadata
# Compute node phyla for internal branches
node_colors <- assign_node_colors(ptree.ad$data, ad.tip_metadata)
ptree.ad$data$Node_Phyla <- factor(node_colors, levels = levels(ad.tip_metadata$Phyla))
# Final styled tree with internal branch coloring
ptree.ad <- ptree.ad +
geom_tree(aes(color = Node_Phyla), size = 0.8, na.rm = FALSE) +
geom_tippoint(aes(color = Phyla), size = 1, na.rm = FALSE) +
scale_color_npg(na.value = "grey50") +
theme_tree2() +
theme(
legend.title = element_text(size = 10),
legend.text = element_text(size = 8),
legend.position = "right",
axis.text = element_blank(),
axis.ticks = element_blank()
)
ptree.ad
# Create the final plot with four combined heatmap rings using Effect column
library(ggnewscale)
# Create combined enriched/depleted columns for each comparison
# Show effects only for taxa that have significant results in each specific comparison
ptree.ad$data <- ptree.ad$data %>%
mutate(
# For int_non_carrier comparison - Use Effect column
int_non_carrier_combined = case_when(
!is.na(int_non_carrier) & Effect == "Enriched" ~ "Enriched",
!is.na(int_non_carrier) & Effect == "Depleted" ~ "Depleted",
TRUE ~ NA_character_
),
# For persistent_non_carrier comparison - Use Effect column
persistent_non_carrier_combined = case_when(
!is.na(persistent_non_carrier) & Effect == "Enriched" ~ "Enriched",
!is.na(persistent_non_carrier) & Effect == "Depleted" ~ "Depleted",
TRUE ~ NA_character_
),
# For persistent_int comparison - Use Effect column
persistent_int_combined = case_when(
!is.na(persistent_int) & Effect == "Enriched" ~ "Enriched",
!is.na(persistent_int) & Effect == "Depleted" ~ "Depleted",
TRUE ~ NA_character_
)
) %>%
# Convert all combined columns to factors to control legends
mutate(
int_non_carrier_combined = factor(int_non_carrier_combined, levels = c("Enriched", "Depleted")),
persistent_non_carrier_combined = factor(persistent_non_carrier_combined, levels = c("Enriched", "Depleted")),
persistent_int_combined = factor(persistent_int_combined, levels = c("Enriched", "Depleted"))
)
final_plot <- ptree.ad +
# Heatmap 2: int_non_carrier Combined (Enriched + Depleted)
new_scale_fill() +
geom_fruit(
geom = geom_tile,
mapping = aes(y = y, x = x, fill = int_non_carrier_combined),
#offset = 0.2,
width = 5,
color = "black",      # Add black borders
size = 0.5            # Border thickness
) +
scale_fill_manual(
name = "Effect",
values = c("Enriched" = "#b03535", "Depleted" = "#2a9df4"),
na.value = "grey95",
drop = TRUE) +
# Heatmap 3: persistent_non_carrier Combined (Enriched + Depleted)
new_scale_fill() +
geom_fruit(
geom = geom_tile,
mapping = aes(y = y, x = x, fill = persistent_non_carrier_combined),
#offset = 0.3,
width = 5,
color = "black",      # Add black borders
size = 0.5            # Border thickness
) +
scale_fill_manual(
name = "Effect",
values = c("Enriched" = "#b03535", "Depleted" = "#2a9df4"),
na.value = "grey95",
drop = TRUE) +
# Heatmap 4: persistent_int Combined (Enriched + Depleted)
new_scale_fill() +
geom_fruit(
geom = geom_tile,
mapping = aes(y = y, x = x, fill = persistent_int_combined),
#offset = 0.4,
width = 5,
color = "black",      # Add black borders
size = 0.5            # Border thickness
) +
scale_fill_manual(
name = "Effect",
values = c("Enriched" = "#b03535", "Depleted" = "#2a9df4"),
na.value = "grey95",
drop = TRUE) +
geom_tiplab(
aes(color = Phyla, label = display_name),  # Color taxa labels by phyla, use display names
offset = 40,        # Move labels just a little further out to avoid overlap
size = 6.0,         # Increase size for better readability
parse = FALSE       # Don't parse as expressions
)
# Display the plot
print(final_plot)
# Save the plot as PNG with larger size to accommodate legends
ggsave("circular_tree_plot_effect_heatmaps.png", final_plot, width = 26, height = 22, dpi = 300)

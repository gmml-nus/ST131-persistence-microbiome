pathway_data_only <- pathway_data_only[complete_both, ]
clinical_vars$carriage_status <- stats::relevel(clinical_vars$carriage_status, ref = "Persistent")
pathway_data_only$carriage_status <- stats::relevel(pathway_data_only$carriage_status, ref = "Persistent")
cat("\nFinal training set size:", nrow(pathway_data_only), "\n")
cat("Carriage status distribution:\n")
print(table(pathway_data_only$carriage_status))
# ==========================================
# 2. USE ALL PATHWAYS (regularization will select)
# ==========================================
clinical_vars_clean <- clinical_vars %>% na.omit()
complete_subjects <- rownames(clinical_vars_clean)
pathway_data_rfe <- pathway_data_only[complete_subjects, ]
pathway_data_rfe <- pathway_data_rfe %>% tidyr::drop_na()
cat("Using all available pathways for Elastic Net:\n")
all_pathway_features <- colnames(pathway_data_rfe)[-1]
cat("Total pathways:", length(all_pathway_features), "\n")
# Remove near-zero variance features
feature_df <- pathway_data_rfe %>% dplyr::select(-carriage_status)
nzv_idx <- caret::nearZeroVar(feature_df)
if (length(nzv_idx) > 0) {
cat("Removing", length(nzv_idx), "near-zero variance features\n")
feature_df <- feature_df[, -nzv_idx, drop = FALSE]
pathway_data_rfe <- dplyr::bind_cols(pathway_data_rfe %>% dplyr::select(carriage_status), feature_df)
}
cat("Pathways after QC:", ncol(pathway_data_rfe) - 1, "\n")
if (length(unique(pathway_data_rfe$carriage_status)) < 2) {
stop("Pathway dataset has a single class after filtering.")
}
cat("Final pathway dataset: n =", nrow(pathway_data_rfe), "\n")
cat("Class distribution:\n")
print(table(pathway_data_rfe$carriage_status))
# ==========================================
# 3. PREPARE DATA FOR ELASTIC NET
# ==========================================
X_pathway <- as.matrix(pathway_data_rfe[, -1])
y_pathway <- pathway_data_rfe$carriage_status
y_numeric <- as.numeric(y_pathway) - 1
n_persistent <- sum(y_numeric == 0)
n_non_carrier <- sum(y_numeric == 1)
weights <- ifelse(y_numeric == 0, n_non_carrier / n_persistent, 1)
cat("\nClass weights:\n")
cat("  Persistent:", weights[1], "\n")
cat("  Non_Carrier:", weights[which(y_numeric == 1)[1]], "\n")
# ==========================================
# 4. ELASTIC NET MODEL WITH CV
# ==========================================
cat("\nTraining Elastic Net models with 5-fold CV...\n")
alphas <- c(0, 0.25, 0.5, 0.75, 1.0)
cv_results <- list()
set.seed(123)
for (alpha in alphas) {
cat("  Alpha =", alpha, "\n")
cv_glmnet <- cv.glmnet(
X_pathway,
y_numeric,
family = "binomial",
alpha = alpha,
weights = weights,
nfolds = 5,
type.measure = "auc",
standardize = TRUE
)
cv_results[[as.character(alpha)]] <- cv_glmnet
}
auc_by_alpha <- sapply(cv_results, function(x) max(x$cvm))
best_alpha <- as.numeric(names(which.max(auc_by_alpha)))
best_cv <- cv_results[[as.character(best_alpha)]]
cat("\nBest alpha:", best_alpha, "(Mean AUC =", round(max(best_cv$cvm), 3), ")\n")
# ==========================================
# 5. ROC ANALYSIS & PREDICTIONS
# ==========================================
pathway_preds <- predict(best_cv, newx = X_pathway, s = "lambda.min", type = "response")[, 1]
roc_pathway <- roc(y_numeric, pathway_preds, quiet = TRUE)
pathway_auc <- round(auc(roc_pathway), 3)
pathway_ci <- ci.auc(roc_pathway)
cat("\nPathway Model (Elastic Net, alpha =", best_alpha, "):\n")
cat("  AUC =", pathway_auc, "\n")
cat("  95% CI: [", round(pathway_ci[1], 3), ",", round(pathway_ci[3], 3), "]\n")
# ==========================================
# 6. FEATURE IMPORTANCE (non-zero coefficients)
# ==========================================
best_lambda <- best_cv$lambda.min
coef_matrix <- coef(best_cv$glmnet.fit, s = best_lambda)
coef_df <- data.frame(
PWY = rownames(coef_matrix)[-1],
Coefficient = as.numeric(coef_matrix[-1, 1]),
stringsAsFactors = FALSE
) %>%
filter(Coefficient != 0) %>%
arrange(desc(abs(Coefficient)))
cat("\nSelected features (non-zero coefficients from regularization):\n")
cat("Number of selected features:", nrow(coef_df), "\n\n")
pwy_names <- read_excel("meta_2025_v7.xlsx", sheet = "pwynames") %>%
dplyr::select(PWY, Names)
coef_display <- coef_df %>%
left_join(pwy_names, by = "PWY") %>%
mutate(
full_name = ifelse(is.na(Names) | Names == "", PWY, Names),
full_name = ifelse(nchar(full_name) > 40, paste0(substr(full_name, 1, 37), "..."), full_name),
Direction = ifelse(Coefficient > 0, "Enriched in Persistent", "Depleted in Persistent")
) %>%
dplyr::select(PWY, full_name, Coefficient, Direction) %>%
arrange(desc(abs(Coefficient)))
print(coef_display)
# ==========================================
# 7. FEATURE IMPORTANCE PLOT
# ==========================================
n_top <- min(15, nrow(coef_display))
plot_data <- coef_display %>% slice_head(n = n_top)
importance_plot <- ggplot(plot_data, aes(x = reorder(full_name, abs(Coefficient)), y = Coefficient,
fill = Direction)) +
geom_col(alpha = 0.8, width = 0.7) +
scale_fill_manual(values = c("Enriched in Persistent" = "#b03535", "Depleted in Persistent" = "#2a9df4")) +
coord_flip() +
labs(
title = "Feature Importance (Elastic Net)",
subtitle = paste0("All Pathway Features (alpha = ", best_alpha, ", selected = ", nrow(coef_df), ")"),
x = "Pathway",
y = "Standardized Coefficient",
fill = "Direction"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
plot.subtitle = element_text(hjust = 0.5, size = 11),
axis.title = element_text(size = 11, face = "bold"),
axis.text.y = element_text(size = 9),
axis.text.x = element_text(size = 10),
legend.position = "bottom",
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_blank()
) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.05)))
print(importance_plot)
ggsave("pathway_elasticnet_importance_allfeatures.png", importance_plot, width = 10, height = 8, dpi = 300)
ggsave("pathway_elasticnet_importance_allfeatures.svg", importance_plot, width = 10, height = 8, dpi = 300)
# ==========================================
# 8. ROC PLOT
# ==========================================
pathway_coords <- coords(roc_pathway, "all", ret = c("threshold", "specificity", "sensitivity"))
roc_data <- data.frame(
Specificity = pathway_coords$specificity,
Sensitivity = pathway_coords$sensitivity,
Threshold = pathway_coords$threshold,
Model = "Elastic Net"
) %>%
arrange(desc(Threshold)) %>%
dplyr::select(-Threshold)
pathway_auc_text <- sprintf("AUC = %.3f (95%% CI: %.3f-%.3f)",
pathway_auc, round(pathway_ci[1], 3), round(pathway_ci[3], 3))
roc_plot <- ggplot(roc_data, aes(x = 1 - Specificity, y = Sensitivity)) +
geom_path(linewidth = 1.2, color = "#4DBBD5FF") +
geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "gray50", alpha = 0.7) +
annotate("text", x = 0.5, y = 0.1, label = pathway_auc_text,
color = "#4DBBD5FF", size = 4, hjust = 0) +
labs(
title = "ROC Curve: Elastic Net Pathway Model",
subtitle = paste0("Persistent vs Non-Carrier (alpha = ", best_alpha, ")"),
x = "False Positive Rate",
y = "True Positive Rate"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
plot.subtitle = element_text(hjust = 0.5, size = 11),
axis.title = element_text(size = 12),
axis.text = element_text(size = 10),
panel.grid.minor = element_blank()
) +
coord_equal()
print(roc_plot)
ggsave("pathway_elasticnet_roc_allfeatures.png", roc_plot, width = 8, height = 8, dpi = 300)
ggsave("pathway_elasticnet_roc_allfeatures.svg", roc_plot, width = 8, height = 8, dpi = 300)
# ==========================================
# 9. ALPHA TUNING PLOT
# ==========================================
alpha_auc <- data.frame(
Alpha = alphas,
AUC = sapply(cv_results, function(x) max(x$cvm))
)
alpha_plot <- ggplot(alpha_auc, aes(x = Alpha, y = AUC)) +
geom_point(size = 3, color = ifelse(Alpha == best_alpha, "#b03535", "gray50")) +
geom_line(color = "gray70", linetype = "dashed") +
labs(
title = "Elastic Net: AUC by Alpha",
x = "Alpha (0 = Ridge, 1 = Lasso)",
y = "Mean AUC (5-fold CV)"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 13, face = "bold"),
axis.title = element_text(size = 11, face = "bold")
) +
ylim(0, 1)
library(randomForest)
library(caret)
library(pROC)
library(readxl)
library(dplyr)
library(ggplot2)
library(tidyr)
# Set working directory and seed
setwd("/Users/nuhibd/Desktop/st131/random_forest")
set.seed(123)
# ==========================================
# 1. LOAD AND PREPARE METADATA
# ==========================================
# Load metadata
meta <- read_excel("metadata2.xlsx", sheet = "R") %>%
dplyr::select(SN, subject_code, timepoint, carrier, age, sex, abx_6months) %>%
mutate(
carrier = factor(carrier, levels = c("non_carrier", "per")),
timepoint = factor(timepoint, levels = c("Baseline")),
sex = factor(sex, levels = c("M", "F")),
abx_6months = factor(abx_6months, levels = c("yes", "no"))
)
# Filter for persistent carriers and non-carriers at BASELINE only
baseline_meta <- meta %>%
filter(carrier %in% c("per", "non_carrier")) %>%
filter(timepoint == "Baseline") %>%
mutate(
carriage_status = factor(
carrier,
levels = c("non_carrier", "per"),
labels = c("Non_Carrier", "Persistent")
),
age_scaled = scale(age)[,1]
) %>%
dplyr::select(SN, subject_code, carriage_status, age_scaled, sex, abx_6months)
cat("\n=== BASELINE METADATA ===\n")
cat("Total baseline samples:", nrow(baseline_meta), "\n")
cat("Class distribution:\n")
print(table(baseline_meta$carriage_status))
# ==========================================
# 2. LOAD AND PREPARE PATHWAY DATA
# ==========================================
# Load pathway abundance data
pwy_raw <- read_excel("pwy_data.xlsx", sheet = "Sheet1")
# Transpose pathway data (samples in rows, pathways in columns)
pathway_abundance <- pwy_raw %>%
pivot_longer(cols = -PWY, names_to = "SN", values_to = "abundance") %>%
pivot_wider(names_from = PWY, values_from = abundance)
cat("\n=== PATHWAY DATA ===\n")
cat("Total pathway samples:", nrow(pathway_abundance), "\n")
cat("Number of pathways:", ncol(pathway_abundance) - 1, "\n")
# ==========================================
# 3. MERGE DATA AND ENSURE COMPLETE CASES
# ==========================================
# Join metadata with pathway data
full_data <- baseline_meta %>%
inner_join(pathway_abundance, by = "SN")
cat("\n=== AFTER JOINING ===\n")
cat("Samples with both metadata and pathway data:", nrow(full_data), "\n")
# Remove samples with ANY missing values
full_data_complete <- full_data %>%
na.omit()
cat("\n=== COMPLETE CASES ===\n")
cat("Final sample size (no missing values):", nrow(full_data_complete), "\n")
cat("Final class distribution:\n")
print(table(full_data_complete$carriage_status))
# ==========================================
# 4. PREPARE CLINICAL AND PATHWAY DATASETS
# ==========================================
# Clinical variables dataset (SAME samples as pathway)
clinical_data <- full_data_complete %>%
dplyr::select(carriage_status, age_scaled, sex, abx_6months)
# Get pathway column names
pathway_cols <- setdiff(colnames(full_data_complete),
c("SN", "subject_code", "carriage_status",
"age", "age_scaled", "sex", "abx_6months"))
# Pathway dataset
pathway_data_raw <- full_data_complete %>%
dplyr::select(carriage_status, all_of(pathway_cols))
# Transform and scale pathway data
cat("\n=== TRANSFORMING PATHWAY DATA ===\n")
# Log transformation (add small constant to avoid log(0))
pathway_log <- log10(pathway_data_raw[, -1] + 1e-6)
# Scale the data
pathway_scaled <- scale(pathway_log)
# Check for problematic values
nan_count <- sum(is.nan(pathway_scaled))
inf_count <- sum(is.infinite(pathway_scaled))
cat("NaN values:", nan_count, "\n")
cat("Inf values:", inf_count, "\n")
# Replace NaN with 0 (happens when variance is 0)
if(nan_count > 0) {
pathway_scaled[is.nan(pathway_scaled)] <- 0
}
# Create final pathway dataset
pathway_data <- data.frame(
carriage_status = pathway_data_raw$carriage_status,
pathway_scaled
)
# ==========================================
# 5. OPTIONAL: FEATURE SELECTION
# ==========================================
# If you have a pre-selected feature list, load it here:
# sig_pwy_list <- read.csv("random forest/sigpwy_list.csv", stringsAsFactors = FALSE)
# selected_features <- intersect(sig_pwy_list$PWY, colnames(pathway_data)[-1])
# pathway_data <- pathway_data %>% dplyr::select(carriage_status, all_of(selected_features))
# Otherwise, use all pathways
n_features <- ncol(pathway_data) - 1
cat("\n=== FEATURE COUNT ===\n")
cat("Number of pathway features:", n_features, "\n")
cat("Samples per feature ratio:", round(nrow(pathway_data) / n_features, 2), "\n")
if(n_features > nrow(pathway_data) / 5) {
warning("WARNING: Too many features relative to samples. Consider feature selection.")
}
# ==========================================
# 6. VERIFY DATA CONSISTENCY
# ==========================================
cat("\n=== DATA CONSISTENCY CHECK ===\n")
cat("Clinical data samples:", nrow(clinical_data), "\n")
cat("Pathway data samples:", nrow(pathway_data), "\n")
cat("Samples match:", nrow(clinical_data) == nrow(pathway_data), "\n")
cat("Row names identical:", identical(rownames(clinical_data), rownames(pathway_data)), "\n")
# Check factor levels
cat("\nFactor levels check:\n")
cat("Clinical carriage_status:", levels(clinical_data$carriage_status), "\n")
cat("Pathway carriage_status:", levels(pathway_data$carriage_status), "\n")
cat("Clinical sex:", levels(clinical_data$sex), "\n")
cat("Clinical abx_6months:", levels(clinical_data$abx_6months), "\n")
# ==========================================
# 7. CROSS-VALIDATION SETUP
# ==========================================
# Create CV folds ONCE - both models will use the same folds
set.seed(123)
cv_folds <- createMultiFolds(
clinical_data$carriage_status,
k = 5,      # 5-fold CV
times = 5   # repeated 5 times
)
# Define training control with pre-defined folds
cv_control <- trainControl(
method = "repeatedcv",
index = cv_folds,  # Use same folds for both models
classProbs = TRUE,
summaryFunction = twoClassSummary,
savePredictions = "final",
verboseIter = FALSE
)
cat("\n=== CROSS-VALIDATION SETUP ===\n")
cat("CV method: 5-fold repeated 5 times (25 iterations)\n")
cat("Total CV iterations:", length(cv_folds), "\n")
# ==========================================
# 8. TRAIN CLINICAL MODEL
# ==========================================
cat("\n=== TRAINING CLINICAL MODEL ===\n")
set.seed(123)
clinical_model <- train(
carriage_status ~ age_scaled + sex + abx_6months,
data = clinical_data,
method = "rf",
trControl = cv_control,
metric = "ROC",
tuneGrid = expand.grid(mtry = 1:3),
ntree = 1000,
importance = TRUE
)
cat("Clinical model training complete.\n")
cat("Best mtry:", clinical_model$bestTune$mtry, "\n")
cat("Best ROC:", round(max(clinical_model$results$ROC), 3), "\n")
# ==========================================
# 9. TRAIN PATHWAY MODEL
# ==========================================
cat("\n=== TRAINING PATHWAY MODEL ===\n")
# Calculate mtry values for pathway model
n_pathway_features <- ncol(pathway_data) - 1
mtry_sqrt <- floor(sqrt(n_pathway_features))
mtry_values <- unique(c(1, mtry_sqrt, min(mtry_sqrt * 2, 20)))
cat("Pathway features:", n_pathway_features, "\n")
cat("Testing mtry values:", paste(mtry_values, collapse = ", "), "\n")
set.seed(123)
pathway_model <- train(
carriage_status ~ .,
data = pathway_data,
method = "rf",
trControl = cv_control,
metric = "ROC",
tuneGrid = expand.grid(mtry = mtry_values),
ntree = 1000,
importance = TRUE
)
cat("Pathway model training complete.\n")
cat("Best mtry:", pathway_model$bestTune$mtry, "\n")
cat("Best ROC:", round(max(pathway_model$results$ROC), 3), "\n")
# ==========================================
# 10. EXTRACT PREDICTIONS AND CALCULATE ROC
# ==========================================
# Extract CV predictions for best tuning parameters
clinical_preds <- clinical_model$pred %>%
filter(mtry == clinical_model$bestTune$mtry)
pathway_preds <- pathway_model$pred %>%
filter(mtry == pathway_model$bestTune$mtry)
cat("\n=== PREDICTION DIAGNOSTICS ===\n")
cat("Clinical predictions:", nrow(clinical_preds), "\n")
cat("Pathway predictions:", nrow(pathway_preds), "\n")
# Check prediction quality
cat("\nClinical - Mean prob for Persistent cases:",
round(mean(clinical_preds$Persistent[clinical_preds$obs == "Persistent"]), 3), "\n")
cat("Clinical - Mean prob for Non_Carrier cases:",
round(mean(clinical_preds$Persistent[clinical_preds$obs == "Non_Carrier"]), 3), "\n")
cat("\nPathway - Mean prob for Persistent cases:",
round(mean(pathway_preds$Persistent[pathway_preds$obs == "Persistent"]), 3), "\n")
cat("Pathway - Mean prob for Non_Carrier cases:",
round(mean(pathway_preds$Persistent[pathway_preds$obs == "Non_Carrier"]), 3), "\n")
# Calculate ROC curves with auto direction
roc_clinical <- roc(
clinical_preds$obs,
clinical_preds$Persistent,
levels = c("Non_Carrier", "Persistent"),
direction = "auto",
quiet = TRUE
)
roc_pathway <- roc(
pathway_preds$obs,
pathway_preds$Persistent,
levels = c("Non_Carrier", "Persistent"),
direction = "auto",
quiet = TRUE
)
# Get AUC and confidence intervals
clinical_auc <- auc(roc_clinical)
pathway_auc <- auc(roc_pathway)
clinical_ci <- ci.auc(roc_clinical)
pathway_ci <- ci.auc(roc_pathway)
cat("\n=== ROC RESULTS ===\n")
cat("Clinical AUC:", round(clinical_auc, 3),
"(95% CI:", round(clinical_ci[1], 3), "-", round(clinical_ci[3], 3), ")\n")
cat("Pathway AUC:", round(pathway_auc, 3),
"(95% CI:", round(pathway_ci[1], 3), "-", round(pathway_ci[3], 3), ")\n")
# DeLong test for comparing AUCs
delong_test <- roc.test(roc_clinical, roc_pathway, method = "delong")
cat("\nDeLong test p-value:", round(delong_test$p.value, 4), "\n")
# ==========================================
# 11. CREATE SMOOTHED ROC PLOT
# ==========================================
# Function to smooth ROC curve
smooth_roc_curve <- function(roc_obj, n_points = 500) {
coords_df <- coords(roc_obj, "all", ret = c("specificity", "sensitivity"))
fpr <- 1 - coords_df$specificity
tpr <- coords_df$sensitivity
# Sort and remove duplicates
order_idx <- order(fpr)
fpr <- fpr[order_idx]
tpr <- tpr[order_idx]
fpr_unique <- unique(fpr)
tpr_unique <- sapply(fpr_unique, function(f) max(tpr[fpr == f]))
# Ensure endpoints
if(fpr_unique[1] != 0) {
fpr_unique <- c(0, fpr_unique)
tpr_unique <- c(0, tpr_unique)
}
if(fpr_unique[length(fpr_unique)] != 1) {
fpr_unique <- c(fpr_unique, 1)
tpr_unique <- c(tpr_unique, 1)
}
# Interpolate
fpr_smooth <- seq(0, 1, length.out = n_points)
tpr_smooth <- approx(fpr_unique, tpr_unique, fpr_smooth,
method = "linear", rule = 2)$y
return(data.frame(FPR = fpr_smooth, TPR = tpr_smooth))
}
# Create smooth ROC data
clinical_smooth <- smooth_roc_curve(roc_clinical)
pathway_smooth <- smooth_roc_curve(roc_pathway)
roc_data <- rbind(
data.frame(clinical_smooth, Model = "Clinical"),
data.frame(pathway_smooth, Model = "Pathway")
)
# Create labels with AUC
clinical_label <- sprintf("Clinical: AUC = %.3f (95%% CI: %.3f-%.3f)",
clinical_auc, clinical_ci[1], clinical_ci[3])
pathway_label <- sprintf("Pathway: AUC = %.3f (95%% CI: %.3f-%.3f)",
pathway_auc, pathway_ci[1], pathway_ci[3])
# Create plot
color_mapping <- c("Clinical" = "#E64B35FF", "Pathway" = "#4DBBD5FF")
roc_plot <- ggplot(roc_data, aes(x = FPR, y = TPR, color = Model)) +
geom_line(linewidth = 1.2, alpha = 0.9) +
geom_abline(intercept = 0, slope = 1, linetype = "dashed",
color = "gray50", alpha = 0.7, linewidth = 0.8) +
scale_color_manual(
values = color_mapping,
labels = c("Clinical" = clinical_label, "Pathway" = pathway_label)
) +
labs(
title = "Random Forest ROC Curves",
subtitle = "Carriage subgroups: Persistent vs Non-Carrier",
x = "False Positive Rate (1 - Specificity)",
y = "True Positive Rate (Sensitivity)"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
plot.subtitle = element_text(hjust = 0.5, size = 11),
legend.position = "bottom",
legend.title = element_blank(),
legend.text = element_text(size = 9),
axis.title = element_text(size = 12),
axis.text = element_text(size = 10),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "gray90")
) +
coord_equal() +
scale_x_continuous(limits = c(0, 1), expand = c(0.01, 0.01)) +
scale_y_continuous(limits = c(0, 1), expand = c(0.01, 0.01))
print(roc_plot)
# Save plot
ggsave("roc_curves_smooth.png", roc_plot, width = 8, height = 8, dpi = 300)
ggsave("roc_curves_smooth.svg", roc_plot, width = 8, height = 8, dpi = 300)
cat("\n=== ANALYSIS COMPLETE ===\n")
cat("Plots saved: roc_curves_smooth.png and roc_curves_smooth.svg\n")

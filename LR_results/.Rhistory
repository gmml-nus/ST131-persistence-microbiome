.groups = "drop"
)
meta_hd_box <- meta_hd_box %>%
dplyr::left_join(household_exposure_box, by = "household") %>%
dplyr::filter(carrier %in% c("non_carrier", "per", "int"), !is.na(carrier)) %>%
dplyr::filter(st131_detect %in% c("yes", "no"), !is.na(st131_detect)) %>%
dplyr::filter(!is.na(hd_exposure)) %>%
dplyr::mutate(
hd_exposure = factor(
hd_exposure,
levels = c("no_exposure", "low_exposure", "high_exposure"),
labels = c("No Exposure", "Low Exposure", "High Exposure")
)
)
hd_counts_box <- table(meta_hd_box$hd_exposure)
meta_hd_box <- meta_hd_box %>%
dplyr::mutate(
hd_exposure = factor(
hd_exposure,
levels = names(hd_counts_box),
labels = paste0(names(hd_counts_box), "\n(n=", as.numeric(hd_counts_box), ")")
)
)
pwy_raw_box <- read_excel("meta_2025_v7.xlsx", sheet = "pwy")
pwy_abundance_box <- pwy_raw_box %>%
tibble::column_to_rownames("PWY") %>%
t() %>%
as.data.frame() %>%
tibble::rownames_to_column("SN")
pathway_cols_box <- setdiff(colnames(pwy_abundance_box), c("SN", "UNMAPPED", "UNINTEGRATED", "UNGROUPED"))
sample_depths_box <- pwy_abundance_box %>%
dplyr::select(SN, dplyr::all_of(pathway_cols_box)) %>%
rowwise() %>%
dplyr::mutate(total_rpk = sum(dplyr::c_across(dplyr::all_of(pathway_cols_box)), na.rm = TRUE)) %>%
ungroup() %>%
dplyr::select(SN, total_rpk)
sig_pwy_hd_avail <- intersect(sig_pwy_hd, colnames(pwy_abundance_box))
if (length(sig_pwy_hd_avail) > 0) {
pwy_long_box <- pwy_abundance_box %>%
dplyr::select(SN, dplyr::all_of(sig_pwy_hd_avail)) %>%
tidyr::gather(PWY, Raw_RPK, -SN) %>%
dplyr::filter(SN %in% meta_hd_box$SN) %>%
dplyr::left_join(sample_depths_box, by = "SN") %>%
dplyr::mutate(
TPM = (as.numeric(Raw_RPK) / total_rpk) * 1e6,
plot_value = log2(TPM + 1)
) %>%
dplyr::left_join(meta_hd_box %>% dplyr::select(SN, hd_exposure), by = "SN") %>%
dplyr::left_join(pwy_names, by = "PWY") %>%
dplyr::mutate(
display_name = dplyr::if_else(is.na(Names) | Names == "", PWY, Names)
)
hd_colors_box <- c("#9191BA", "#accc87", "#b03535")
names(hd_colors_box) <- levels(meta_hd_box$hd_exposure)
plot_list_hd_pwy <- list()
all_stats_hd_pwy <- list()
for (pwy_id in sig_pwy_hd_avail) {
d <- pwy_long_box %>% dplyr::filter(.data$PWY == .env$pwy_id)
feat_name <- unique(d$display_name)[1]
feat_title <- stringr::str_wrap(feat_name, width = 40)
res <- create_boxplot_stats(d, "hd_exposure", feat_title, "Log2(TPM)", hd_colors_box)
plot_list_hd_pwy[[pwy_id]] <- res$plot
all_stats_hd_pwy[[pwy_id]] <- res$stats %>%
dplyr::mutate(PWY = pwy_id, Feature = feat_name, .before = 1)
}
combined_hd_pwy_box <- patchwork::wrap_plots(plot_list_hd_pwy, ncol = min(2, length(plot_list_hd_pwy))) +
patchwork::plot_annotation(
title = "Pathway abundance by household exposure",
theme = theme(plot.title = element_text(size = 14, face = "bold", hjust = 0.5))
) +
patchwork::plot_layout(guides = "collect") &
theme(legend.position = "bottom")
ggplot2::ggsave("pathway_hd_exposure_boxplots.svg", combined_hd_pwy_box, width = 12, height = 6, dpi = 300)
ggplot2::ggsave("pathway_hd_exposure_boxplots.png", combined_hd_pwy_box, width = 12, height = 6, dpi = 300)
readr::write_csv(
dplyr::bind_rows(all_stats_hd_pwy) %>%
dplyr::rename(q_value_BH = p_adj),
"pathway_hd_exposure_boxplots_pvalues.csv"
)
}
}
# --- 5. Taxa Household Exposure Plot ---
prepare_taxa_comparison_data <- function(file, term, label, taxa_list) {
read.csv(file) %>%
filter(term == !!term, Species %in% taxa_list) %>%
mutate(
display_name = Species,
comparison = label,
log_fold_change = estimate,
effect_direction = factor(ifelse(padj < 0.05, ifelse(estimate > 0, "Enriched", "Depleted"), "Not Significant"),
levels = c("Enriched", "Depleted", "Not Significant")),
alpha_value = ifelse(padj < 0.05, 0.8, 0.3)
) %>%
dplyr::select(display_name, comparison, log_fold_change, effect_direction, alpha_value)
}
taxa_hd_res <- read.csv("sigtaxa_hd_exposure.csv")
taxa_hd_hl_res <- read.csv("sigtaxa_hd_exposure_high_vs_low.csv")
sig_taxa_hd <- unique(c(
taxa_hd_res %>% filter(term == "hd_exposurehigh_exposure", abs(estimate) > 0.3, padj < 0.05) %>% pull(Species),
taxa_hd_res %>% filter(term == "hd_exposurelow_exposure", abs(estimate) > 0.3, padj < 0.05) %>% pull(Species),
taxa_hd_hl_res %>% filter(term == "hd_exposurehigh_exposure", abs(estimate) > 0.3, padj < 0.05) %>% pull(Species)
))
if (length(sig_taxa_hd) > 0) {
combined_taxa_hd <- bind_rows(
prepare_taxa_comparison_data("sigtaxa_hd_exposure.csv", "hd_exposurehigh_exposure", "High vs No Exposure", sig_taxa_hd),
prepare_taxa_comparison_data("sigtaxa_hd_exposure_high_vs_low.csv", "hd_exposurehigh_exposure", "High vs Low Exposure", sig_taxa_hd),
prepare_taxa_comparison_data("sigtaxa_hd_exposure.csv", "hd_exposurelow_exposure", "Low vs No Exposure", sig_taxa_hd)
)
taxa_hd_order <- combined_taxa_hd %>% group_by(display_name) %>% summarize(m = max(abs(log_fold_change))) %>% arrange(m) %>% pull(display_name)
combined_taxa_hd$display_name <- factor(combined_taxa_hd$display_name, levels = taxa_hd_order)
combined_taxa_hd <- add_dummy_data(combined_taxa_hd)
p6 <- build_panel(combined_taxa_hd %>% filter(comparison == "High vs No Exposure"), "High vs No Exposure") + labs(x = "Taxa")
p7 <- build_panel(combined_taxa_hd %>% filter(comparison == "High vs Low Exposure"), "High vs Low Exposure", FALSE) + labs(x = "Taxa")
p7b <- build_panel(combined_taxa_hd %>% filter(comparison == "Low vs No Exposure"), "Low vs No Exposure", FALSE) + labs(x = "Taxa")
ggsave("combined_taxa_hd_exposure.svg", (p6 | p7 | p7b) + plot_layout(guides = "collect") & theme(legend.position = "bottom"), width = 16, height = 8)
# --- 5b. Taxa household exposure boxplots (same pipeline as abs/feature_boxplots_2.R: log10 rel ab + KW / Dunn BH) ---
meta_taxa_box <- read_excel("meta_2025_v7.xlsx", sheet = "R")
household_exposure_taxa <- meta_taxa_box %>%
dplyr::group_by(household) %>%
dplyr::summarise(
hd_exposure = dplyr::case_when(
any(carrier == "per", na.rm = TRUE) ~ "high_exposure",
any(carrier == "int", na.rm = TRUE) ~ "low_exposure",
all(carrier == "non_carrier", na.rm = TRUE) ~ "no_exposure",
TRUE ~ NA_character_
),
.groups = "drop"
)
meta_taxa_box <- meta_taxa_box %>%
dplyr::left_join(household_exposure_taxa, by = "household") %>%
dplyr::select(SN, rawseqID, carrier, st131_detect, hd_exposure) %>%
dplyr::filter(carrier %in% c("non_carrier", "per", "int"), !is.na(carrier)) %>%
dplyr::filter(st131_detect %in% c("yes", "no"), !is.na(st131_detect)) %>%
dplyr::filter(!is.na(hd_exposure)) %>%
dplyr::mutate(
hd_exposure = factor(
hd_exposure,
levels = c("no_exposure", "low_exposure", "high_exposure"),
labels = c("No Exposure", "Low Exposure", "High Exposure")
)
)
hd_counts_taxa <- table(meta_taxa_box$hd_exposure)
meta_taxa_box <- meta_taxa_box %>%
dplyr::mutate(
hd_exposure = factor(
hd_exposure,
levels = names(hd_counts_taxa),
labels = paste0(names(hd_counts_taxa), "\n(n=", as.numeric(hd_counts_taxa), ")")
)
)
taxa_data_hd <- read_excel("meta_2025_v7.xlsx", sheet = "taxa") %>%
dplyr::select(-Kingdom, -Phyla, -Class, -Order, -Family, -Genus) %>%
dplyr::filter(.data$Species %in% sig_taxa_hd) %>%
tidyr::pivot_longer(cols = -Species, names_to = "rawseqID", values_to = "relab") %>%
dplyr::mutate(
relab = .data$relab / 100,
plot_value = log10(.data$relab + 1e-6)
) %>%
dplyr::filter(.data$rawseqID %in% meta_taxa_box$rawseqID) %>%
dplyr::left_join(meta_taxa_box %>% dplyr::select(rawseqID, hd_exposure), by = "rawseqID")
hd_colors_taxa <- c("#9191BA", "#accc87", "#b03535")
names(hd_colors_taxa) <- levels(meta_taxa_box$hd_exposure)
plot_list_taxa_hd <- list()
all_stats_taxa_hd <- list()
for (taxon in taxa_hd_order) {
d <- taxa_data_hd %>% dplyr::filter(.data$Species == .env$taxon)
if (nrow(d) < 3L) next
# Facet / strip label = full Species ID, same as barplot display_name
res <- create_boxplot_stats(d, "hd_exposure", taxon, "Log10(Relative Abundance)", hd_colors_taxa)
plot_list_taxa_hd[[taxon]] <- res$plot
all_stats_taxa_hd[[taxon]] <- res$stats %>%
dplyr::mutate(Species = taxon, .before = 1)
}
if (length(plot_list_taxa_hd) > 0) {
taxa_box_order <- rev(taxa_hd_order[taxa_hd_order %in% names(plot_list_taxa_hd)])
combined_taxa_hd_box <- patchwork::wrap_plots(plot_list_taxa_hd[taxa_box_order], ncol = 4) +
patchwork::plot_annotation(
title = "Taxa abundance by household exposure",
theme = theme(plot.title = element_text(size = 16, face = "bold", hjust = 0.5))
) +
patchwork::plot_layout(guides = "collect") &
theme(legend.position = "bottom")
n_panels <- length(plot_list_taxa_hd)
ggplot2::ggsave("taxa_hd_exposure_boxplots.svg", combined_taxa_hd_box, width = 14, height = max(10, 2 + 2.2 * ceiling(n_panels / 4)), dpi = 300)
ggplot2::ggsave("taxa_hd_exposure_boxplots.png", combined_taxa_hd_box, width = 14, height = max(10, 2 + 2.2 * ceiling(n_panels / 4)), dpi = 300)
readr::write_csv(
dplyr::bind_rows(all_stats_taxa_hd[taxa_box_order]) %>%
dplyr::rename(q_value_BH = p_adj),
"taxa_hd_exposure_boxplots_pvalues.csv"
)
message("Saved taxa_hd_exposure_boxplots.svg/png and taxa_hd_exposure_boxplots_pvalues.csv")
}
# --- 5c. Heatmap: mean log10(relab + 1e-6) after relab/100 — same transform as taxa HD boxplots.
#         Rows = taxa, columns = exposure groups; hierarchical clustering (complete linkage, Euclidean) on both axes when n > 1.
meta_taxa_hm <- read_excel("meta_2025_v7.xlsx", sheet = "R")
household_exposure_hm <- meta_taxa_hm %>%
dplyr::group_by(household) %>%
dplyr::summarise(
hd_exposure = dplyr::case_when(
any(carrier == "per", na.rm = TRUE) ~ "high_exposure",
any(carrier == "int", na.rm = TRUE) ~ "low_exposure",
all(carrier == "non_carrier", na.rm = TRUE) ~ "no_exposure",
TRUE ~ NA_character_
),
.groups = "drop"
)
meta_taxa_hm <- meta_taxa_hm %>%
dplyr::left_join(household_exposure_hm, by = "household") %>%
dplyr::filter(carrier %in% c("non_carrier", "per", "int"), !is.na(carrier)) %>%
dplyr::filter(st131_detect %in% c("yes", "no"), !is.na(st131_detect)) %>%
dplyr::filter(!is.na(hd_exposure)) %>%
dplyr::mutate(
hd_exposure = factor(
hd_exposure,
levels = c("no_exposure", "low_exposure", "high_exposure"),
labels = c("No exposure", "Low exposure", "High exposure")
)
)
taxa_long_hm <- read_excel("meta_2025_v7.xlsx", sheet = "taxa") %>%
dplyr::select(-Kingdom, -Phyla, -Class, -Order, -Family, -Genus) %>%
dplyr::filter(.data$Species %in% sig_taxa_hd) %>%
tidyr::pivot_longer(cols = -Species, names_to = "rawseqID", values_to = "relab_raw") %>%
dplyr::mutate(
relab_raw = as.numeric(.data$relab_raw),
# Same as boxplots: relative abundance as proportion, then log10(relab + 1e-6)
relab = .data$relab_raw / 100,
plot_value = log10(.data$relab + 1e-6)
) %>%
dplyr::inner_join(
meta_taxa_hm %>% dplyr::select(rawseqID, hd_exposure),
by = "rawseqID"
)
hm_summary <- taxa_long_hm %>%
dplyr::group_by(Species, hd_exposure) %>%
dplyr::summarise(mean_log10_relab = mean(.data$plot_value, na.rm = TRUE), .groups = "drop") %>%
tidyr::pivot_wider(names_from = hd_exposure, values_from = mean_log10_relab)
col_order <- c("No exposure", "Low exposure", "High exposure")
missing_cols <- setdiff(col_order, colnames(hm_summary))
for (mc in missing_cols) {
hm_summary[[mc]] <- NA_real_
}
hm_summary <- hm_summary %>%
dplyr::select(Species, dplyr::all_of(col_order))
# Same row order as household-exposure taxa barplots (taxa_hd_order = increasing max |log FC|; barplot
# typically shows increasing |FC| bottom→top after coord_flip, so largest |FC| at top = last in taxa_hd_order)
hm_summary <- hm_summary %>%
dplyr::mutate(Species_ord = factor(Species, levels = taxa_hd_order)) %>%
dplyr::arrange(dplyr::desc(as.integer(Species_ord))) %>%
dplyr::filter(!is.na(Species_ord)) %>%
dplyr::select(-Species_ord)
mat <- hm_summary %>%
tibble::column_to_rownames("Species") %>%
as.matrix()
# Row names = Species IDs as in barplot tables (keep s__, underscores, etc.)
min_val <- suppressWarnings(min(mat, na.rm = TRUE))
max_val <- suppressWarnings(max(mat, na.rm = TRUE))
if (!is.finite(min_val)) min_val <- -6
if (!is.finite(max_val) || max_val <= min_val) max_val <- min_val + 0.01
brks <- min_val + (0:3 / 3) * (max_val - min_val)
col_fun <- circlize::colorRamp2(
brks,
c("#053061", "#2166ac", "#f46d43", "#a50026")
)
ht <- ComplexHeatmap::Heatmap(
mat,
name = "Mean\nlog10(rel+ab)",
col = col_fun,
cluster_rows = nrow(mat) > 1,
cluster_columns = ncol(mat) > 1,
clustering_method_rows = "complete",
clustering_method_columns = "complete",
row_names_gp = grid::gpar(fontsize = 9),
column_names_gp = grid::gpar(fontsize = 10),
heatmap_legend_param = list(title = "Mean log10\n(relab + 1e-6)"),
border = TRUE
)
h_main <- max(4.5, 0.18 * nrow(mat) + 2.5)
w_main <- 8
grDevices::pdf("taxa_hd_exposure_log10_relab_heatmap.pdf", width = w_main, height = h_main)
ComplexHeatmap::draw(ht)
grDevices::dev.off()
grDevices::svg("taxa_hd_exposure_log10_relab_heatmap.svg", width = w_main, height = h_main)
ComplexHeatmap::draw(ht)
grDevices::dev.off()
grDevices::png("taxa_hd_exposure_log10_relab_heatmap.png", width = round(w_main * 100), height = max(400, 36 * nrow(mat) + 200), res = 100)
ComplexHeatmap::draw(ht)
grDevices::dev.off()
# Transposed: rows = household exposure, columns = taxa (same values, same color scale)
mat_t <- t(mat)
ht_t <- ComplexHeatmap::Heatmap(
mat_t,
name = "Mean\nlog10(rel+ab)",
col = col_fun,
cluster_rows = nrow(mat_t) > 1,
cluster_columns = ncol(mat_t) > 1,
clustering_method_rows = "complete",
clustering_method_columns = "complete",
row_names_gp = grid::gpar(fontsize = 11),
column_names_gp = grid::gpar(fontsize = 7),
column_names_rot = 90,
heatmap_legend_param = list(title = "Mean log10\n(relab + 1e-6)"),
border = TRUE
)
w_t <- max(13, 0.14 * ncol(mat_t) + 4)
h_t <- max(5, 0.35 * nrow(mat_t) + 3)
grDevices::pdf("taxa_hd_exposure_log10_relab_heatmap_transposed.pdf", width = w_t, height = h_t)
ComplexHeatmap::draw(ht_t)
grDevices::dev.off()
grDevices::svg("taxa_hd_exposure_log10_relab_heatmap_transposed.svg", width = w_t, height = h_t)
ComplexHeatmap::draw(ht_t)
grDevices::dev.off()
grDevices::png(
"taxa_hd_exposure_log10_relab_heatmap_transposed.png",
width = min(3200, 100 * ncol(mat_t) + 400),
height = max(360, 120 * nrow(mat_t) + 240),
res = 100
)
ComplexHeatmap::draw(ht_t)
grDevices::dev.off()
readr::write_csv(
hm_summary %>% dplyr::rename(taxon = Species),
"taxa_hd_exposure_log10_relab_heatmap_values.csv"
)
readr::write_csv(
tibble::rownames_to_column(as.data.frame(mat_t), "hd_exposure"),
"taxa_hd_exposure_log10_relab_heatmap_transposed_values.csv"
)
message(
"Saved taxa_hd_exposure_log10_relab_heatmap.pdf/svg/png and taxa_hd_exposure_log10_relab_heatmap_values.csv; ",
"transposed: taxa_hd_exposure_log10_relab_heatmap_transposed.pdf/svg/png and _transposed_values.csv ",
"(row/column hierarchical clustering where n > 1; complete linkage Euclidean)"
)
}
library(tidyverse)
library(readxl)
library(patchwork)
library(rstatix)
library(ggpubr)
if (!requireNamespace("ComplexHeatmap", quietly = TRUE)) {
stop("Install ComplexHeatmap: BiocManager::install('ComplexHeatmap')")
}
if (!requireNamespace("circlize", quietly = TRUE)) {
stop("Install circlize: install.packages('circlize')")
}
setwd("/Users/zyggyzdys/Desktop/github/st131/LR_results")
# Boxplot + stats (Kruskal–Wallis, Dunn with BH-adjusted p, significance stars) — same style as abs/feature_boxplots_2.R
create_boxplot_stats <- function(data, group_col, title, y_label, colors) {
group_sym <- sym(group_col)
num_groups <- length(unique(data[[group_col]]))
stats_df_list <- list()
data <- data %>% mutate(Feature = title)
if (num_groups > 2) {
stat_res <- data %>%
kruskal_test(as.formula(paste("plot_value ~", group_col))) %>%
add_significance("p")
pval_label <- paste0("p = ", signif(stat_res$p, 3))
stats_df_list[[1]] <- data.frame(
Feature = title, Group_Variable = group_col, Test = "Kruskal-Wallis",
Group1 = "All", Group2 = "All", p_value = stat_res$p, p_adj = NA,
Significance = stat_res$p.signif, stringsAsFactors = FALSE
)
} else {
stat_res <- data %>%
wilcox_test(as.formula(paste("plot_value ~", group_col))) %>%
add_significance("p")
pval_label <- paste0("p = ", signif(stat_res$p, 3))
stats_df_list[[1]] <- data.frame(
Feature = title, Group_Variable = group_col, Test = "Wilcoxon",
Group1 = stat_res$group1, Group2 = stat_res$group2, p_value = stat_res$p, p_adj = NA,
Significance = stat_res$p.signif, stringsAsFactors = FALSE
)
}
pval_text_df <- data.frame(
Feature = title,
pval_label = pval_label,
x_pos = Inf,
y_pos = Inf
)
p <- ggplot(data, aes(x = !!group_sym, y = plot_value, fill = !!group_sym)) +
geom_boxplot(outlier.shape = NA, alpha = 0.7, color = "grey20") +
geom_jitter(width = 0.2, alpha = 0.6, size = 1.5, color = "grey30") +
scale_fill_manual(values = colors) +
facet_wrap(~ Feature) +
geom_text(
data = pval_text_df, aes(x = x_pos, y = y_pos, label = pval_label),
inherit.aes = FALSE, hjust = 1.1, vjust = 1.5, size = 3.5, fontface = "italic"
) +
labs(x = "", y = y_label, fill = tools::toTitleCase(gsub("_", " ", group_col))) +
theme_bw() +
theme(legend.position = "none", strip.text = element_text(size = 9, face = "bold"))
if (stat_res$p < 0.05) {
if (num_groups > 2) {
dunn_res <- data %>%
dunn_test(as.formula(paste("plot_value ~", group_col)), p.adjust.method = "BH") %>%
add_significance("p.adj") %>%
add_xy_position(x = group_col, dodge = 0.8)
stats_df_list[[2]] <- data.frame(
Feature = title, Group_Variable = group_col, Test = "Dunn (post-hoc)",
Group1 = dunn_res$group1, Group2 = dunn_res$group2, p_value = dunn_res$p, p_adj = dunn_res$p.adj,
Significance = dunn_res$p.adj.signif, stringsAsFactors = FALSE
)
sig_dunn <- dunn_res %>% filter(p.adj < 0.05)
if (nrow(sig_dunn) > 0) {
p <- p + stat_pvalue_manual(
sig_dunn,
label = "p.adj.signif",
hide.ns = TRUE,
tip.length = 0.01,
step.increase = 0.05
)
}
} else {
wilcox_res_pos <- stat_res %>% add_xy_position(x = group_col)
p <- p + stat_pvalue_manual(
wilcox_res_pos,
label = "p.signif",
hide.ns = TRUE,
tip.length = 0.01
)
}
}
list(plot = p, stats = dplyr::bind_rows(stats_df_list))
}
# Load pathway name mappings
pwy_names <- read_excel("meta_2025_v7.xlsx", sheet = "pwynames") %>%
dplyr::select(PWY, Names)

{
lmerTest::lmer(formula_lmer, data = data)
},
error = function(e) {
lm(formula_lm, data = data)
}
)
} else {
lm(formula_lm, data = data)
}
}
# Helper function to create volcano plots
make_volcano <- function(df, feature_col, term_exact, title, outfile, label_top = 15, padj_thresh = 0.05) {
d <- df %>% filter(term == term_exact) %>% mutate(minuslog10padj = -log10(padj))
if (nrow(d) == 0) return(invisible(NULL))
d <- d %>% mutate(sig = padj < padj_thresh,
fold_change = 10^estimate)
top_labs <- d %>% arrange(padj) %>% head(label_top) %>% pull({{feature_col}})
p <- ggplot(d, aes(x = estimate, y = minuslog10padj, color = sig)) +
geom_point(alpha = 0.8) +
scale_color_manual(values = c("FALSE" = "grey70", "TRUE" = "#b03535")) +
geom_vline(xintercept = 0, linetype = "dashed") +
geom_hline(yintercept = -log10(padj_thresh), linetype = "dotted") +
ggrepel::geom_text_repel(data = d %>% filter(({{feature_col}}) %in% top_labs),
aes(label = {{feature_col}}), size = 3, max.overlaps = 20) +
labs(title = title, x = "Effect size (log10 scale)", y = expression(-log[10](FDR))) +
theme_bw()
ggsave(outfile, p, width = 7, height = 5, dpi = 150)
print(p)
}
# Helper function to create top effect bar charts
make_topbar <- function(df, feature_col, term_exact, title, outfile, top_n = 20, padj_thresh = 0.05) {
d <- df %>% filter(term == term_exact, padj < padj_thresh) %>%
arrange(padj) %>% head(top_n)
if (nrow(d) == 0) return(invisible(NULL))
p <- ggplot(d, aes(x = reorder({{feature_col}}, estimate), y = estimate, fill = estimate > 0)) +
geom_col() +
scale_fill_manual(values = c("FALSE" = "#3549b0", "TRUE" = "#b03535")) +
coord_flip() +
labs(title = title, x = "", y = "Effect size (log10 scale)") +
theme_bw() +
theme(legend.position = "none")
ggsave(outfile, p, width = 8, height = 6, dpi = 150)
print(p)
}
# Helper function to load name mappings
load_name_map <- function(file_path, id_col, name_col) {
if (file.exists(file_path)) {
read.csv(file_path) %>% dplyr::select({{id_col}}, {{name_col}})
} else {
NULL
}
}
# Helper function to create summary tables
create_summary_table <- function(results_df, feature_col, term_exact, title) {
sig_results <- results_df %>%
filter(term == term_exact, padj < 0.05) %>%
arrange(padj) %>%
dplyr::select({{feature_col}}, estimate, p.value, padj) %>%
mutate(
effect_direction = ifelse(estimate > 0, "Increased", "Decreased"),
significance = case_when(
padj < 0.001 ~ "***",
padj < 0.01 ~ "**",
padj < 0.05 ~ "*",
TRUE ~ ""
)
)
if (nrow(sig_results) > 0) {
cat(paste0("\n## ", title, "\n"))
print(sig_results %>% head(10) %>% kable(digits = 4))
cat(paste0("Total significant features: ", nrow(sig_results), "\n"))
} else {
cat(paste0("\n## ", title, "\n"))
cat("No significant features found.\n")
}
}
# TAXA ANALYSIS
# Build modeling dataset: taxa log10 table joined with metadata (ALL samples)
taxa_model <- read_excel("meta_2025_v6.xlsx", sheet = "taxa") %>%
select(-Kingdom, -Phyla, -Class, -Order, -Family, -Genus) %>%
gather(rawseqID, relab, -Species) %>%
mutate(relab = relab/100) %>%
spread(Species, relab) %>%
filter(rawseqID %in% c(meta_car2$rawseqID))
taxa_model[is.na(taxa_model)] <- 0
species_mat_model <- taxa_model %>% column_to_rownames(var = "rawseqID")
species_mat_model <- as.data.frame(species_mat_model)
species_mat_model[] <- lapply(species_mat_model, function(x) as.numeric(x))
species_mat_model <- species_mat_model[rowSums(species_mat_model, na.rm = TRUE) > 0, , drop = FALSE]
species_relab_model <- decostand(species_mat_model, MARGIN = 1, method = "total")
bugs_f_model <- species_relab_model[, which(apply(species_relab_model, 2, function(x) length(which(x>0))/length(x)) > 0.05), drop = FALSE]
bugs_ff_model <- apply(bugs_f_model, 2, function(x){ x[x==0] = min(x[x>0])/2; x })
bugs_log10_model <- log10(bugs_ff_model)
mgx.log10.model <- bugs_log10_model %>% as_tibble(rownames = "rawseqID")
mgx_log10_meta <- mgx.log10.model %>%
left_join(meta_car2, by = "rawseqID") %>%
drop_na(sex, age, abx_6months, subject_code)
# Ensure species list aligns with mgx.log10 columns
species_columns <- setdiff(colnames(mgx_log10_meta), c("rawseqID","sex","age","abx_6months","subject_code","carrier","st131_detect","SN","sample_code","household","reads","timepoint","index_pt","st131_qpcr_trpa_pabb","st131_mnth","st131_mnth_isolate_count","st131_wgs","st131pos_density_wgs","raw_counts","old_SN"))
mgx_log10_meta$carrier2 <- relevel(factor(mgx_log10_meta$carrier2), ref = "non")
mgx_log10_meta$st131_detect <- relevel(factor(mgx_log10_meta$st131_detect), ref = "no")
# Linear mixed models (nested): taxa ~ carrier2/st131_detect + covariates
lm.taxa.carrier2.nested <- purrr::map(
rlang::set_names(species_columns),
~ fit_taxa_model(
data = mgx_log10_meta,
response_col = .x,
fixed_part = "carrier2/st131_detect + sex + age + abx_6months",
random_group = "subject_code"
)
)
lm.taxa.carrier2.nested.df <- purrr::map_dfr(lm.taxa.carrier2.nested, broom.mixed::tidy, .id = "Species") %>%
dplyr::filter(effect == "fixed") %>%
dplyr::mutate(padj = p.adjust(p.value, method = "fdr")) %>%
dplyr::select(Species, term, estimate, std.error, statistic, df, p.value, padj)
write.csv(lm.taxa.carrier2.nested.df, "sigtaxa_carrier2_nested.csv", row.names = FALSE)
# PATHWAY ANALYSIS
# Build join keys locally for this chunk (ALL samples)
meta_keys_pwy <- meta_car2 %>%
dplyr::select(rawseqID, SN, sex, age, abx_6months, subject_code, carrier2, st131_detect) %>%
pivot_longer(cols = c(rawseqID, SN), names_to = "key", values_to = "sample_id") %>%
filter(!is.na(sample_id)) %>%
distinct(sample_id, .keep_all = TRUE) %>%
dplyr::select(-key)
# Load and process PWY features (relative abundance, filter >5% prevalence, log10)
pwy_df <- read_excel("meta_2025_v6.xlsx", sheet = "pwy") %>%
gather(sample_id, relab, -PWY) %>%
mutate(relab = relab/100) %>%
spread(PWY, relab) %>%
filter(sample_id %in% c(meta_car2$rawseqID, meta_car2$SN))
# Replace NAs in feature columns with 0
pwy_df[setdiff(colnames(pwy_df), "sample_id")] <- lapply(pwy_df[setdiff(colnames(pwy_df), "sample_id")], function(x){ x[is.na(x)] <- 0; as.numeric(x) })
pwy_mat <- pwy_df %>% column_to_rownames(var = "sample_id")
pwy_mat <- as.data.frame(pwy_mat)
pwy_mat <- pwy_mat[rowSums(pwy_mat, na.rm = TRUE) > 0, , drop = FALSE]
pwy_relab <- decostand(pwy_mat, MARGIN = 1, method = "total")
pwy_f <- pwy_relab[, which(apply(pwy_relab, 2, function(x) length(which(x>0))/length(x)) > 0.05), drop = FALSE]
pwy_ff <- apply(pwy_f, 2, function(x){ x[x==0] = min(x[x>0])/2; x })
pwy_log10 <- log10(pwy_ff)
pwy.log10 <- pwy_log10 %>% as_tibble(rownames = "sample_id") %>% left_join(meta_keys_pwy, by = c("sample_id" = "sample_id"))
pwy_features <- setdiff(colnames(pwy.log10), c("sample_id", "sex", "age", "abx_6months", "subject_code", "carrier", "st131_detect"))
if (nrow(pwy.log10) > 0) {
pwy.log10$carrier2 <- relevel(factor(pwy.log10$carrier2), ref = "non")
pwy.log10$st131_detect <- relevel(factor(pwy.log10$st131_detect), ref = "no")
lm.pwy.carrier2.nested <- purrr::map(
rlang::set_names(pwy_features),
~ fit_taxa_model(
data = pwy.log10 %>% drop_na(sex, age, abx_6months, subject_code),
response_col = .x,
fixed_part = "carrier2/st131_detect + sex + age + abx_6months",
random_group = "subject_code"
)
)
lm.pwy.carrier2.nested.df <- purrr::map_dfr(lm.pwy.carrier2.nested, broom.mixed::tidy, .id = "PWY") %>%
dplyr::filter(effect == "fixed") %>%
dplyr::mutate(padj = p.adjust(p.value, method = "fdr")) %>%
dplyr::select(PWY, term, estimate, std.error, statistic, df, p.value, padj)
write.csv(lm.pwy.carrier2.nested.df, "sigpwy_carrier2_nested.csv", row.names = FALSE)
}

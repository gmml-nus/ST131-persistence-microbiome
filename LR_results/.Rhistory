library(vegan)
library(broom.mixed)
library(lmerTest)
library(reshape)
library(rstatix)
setwd("/Users/zyggyzdys/Desktop/github/st131/LR_results")
meta <- read_excel("meta_2025_v7.xlsx", sheet = "R") %>%
dplyr::select(SN, rawseqID, sample_code, subject_code, household, reads, timepoint, carrier,	st131_detect, age,
sex, abx_6months,	index_pt,	st131_qpcr_trpa_pabb, st131_mnth,	st131_mnth_isolate_count, st131_wgs,
st131pos_density_wgs,	raw_counts,	old_SN) %>%
mutate(st131_detect=factor(st131_detect, levels=c("yes", "no", "NA")),
index_pt=factor(index_pt, levels=c("yes", "no")),
carrier = factor(carrier, levels =c("non_carrier", "per", "int")),
abx_6months=factor(abx_6months, levels=c("yes","no")),
timepoint=factor(timepoint, levels=c("Baseline", "Repeat")),
sex=factor(sex, levels=c("M", "F")),
subject_code=factor(subject_code),
household=factor(household))
# Filter to analyse only persistent carriage currently omit NA (no NA samples)
# ALSO filter out st131_detect NA for ALL analyses
meta_per<-meta%>%
filter(carrier %in% c("non_carrier", "per", "int"), !is.na(carrier),
st131_detect %in% c("yes", "no")) %>%
droplevels()
cat("Carrier status distribution (after removing st131_detect NA):\n")
print(table(meta_per$carrier))
cat("\nST131 detection distribution:\n")
print(table(meta_per$st131_detect))
# Helper function to fit lmer if subject repeats exist; otherwise fall back to lm
fit_taxa_model <- function(data, response_col, fixed_part, random_group) {
has_repeat <- any(table(data[[random_group]]) > 1)
formula_lm   <- as.formula(paste(response_col, "~", fixed_part))
formula_lmer <- as.formula(paste(response_col, "~", fixed_part, "+ (1|", random_group, ")"))
if (has_repeat) {
tryCatch(
{
lmerTest::lmer(formula_lmer, data = data)
},
error = function(e) {
lm(formula_lm, data = data)
}
)
} else {
lm(formula_lm, data = data)
}
}
# Helper to load a list of feature IDs from a CSV column or return empty
load_feature_list <- function(file_path, id_col_name) {
if (!file.exists(file_path)) return(character(0))
df <- tryCatch(read.csv(file_path, stringsAsFactors = FALSE), error = function(e) NULL)
if (is.null(df)) return(character(0))
if (!(id_col_name %in% names(df))) return(character(0))
unique(df[[id_col_name]])
}

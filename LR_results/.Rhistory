dplyr::select(rawseqID, SN, sex, age, abx_6months, subject_code, carrier2, st131_detect) %>%
pivot_longer(cols = c(rawseqID, SN), names_to = "key", values_to = "sample_id") %>%
filter(!is.na(sample_id)) %>%
distinct(sample_id, .keep_all = TRUE) %>%
dplyr::select(-key)
# Load and process CARD features (relative abundance, filter >5% prevalence, log10)
card_df <- read_excel("meta_2025_v6.xlsx", sheet = "card") %>%
gather(sample_id, relab, -CARD) %>%
mutate(relab = relab/100) %>%
spread(CARD, relab) %>%
filter(sample_id %in% c(meta_car2$rawseqID, meta_car2$SN))
# Replace NAs in feature columns with 0
card_df[setdiff(colnames(card_df), "sample_id")] <- lapply(card_df[setdiff(colnames(card_df), "sample_id")], function(x){ x[is.na(x)] <- 0; as.numeric(x) })
card_mat <- card_df %>% column_to_rownames(var = "sample_id")
card_mat <- as.data.frame(card_mat)
card_mat <- card_mat[rowSums(card_mat, na.rm = TRUE) > 0, , drop = FALSE]
card_relab <- decostand(card_mat, MARGIN = 1, method = "total")
card_f <- card_relab[, which(apply(card_relab, 2, function(x) length(which(x>0))/length(x)) > 0.05), drop = FALSE]
card_ff <- apply(card_f, 2, function(x){ x[x==0] = min(x[x>0])/2; x })
card_log10 <- log10(card_ff)
card.log10 <- card_log10 %>% as_tibble(rownames = "sample_id") %>%
left_join(meta_keys_card, by = c("sample_id" = "sample_id")) %>%
filter(st131_detect %in% c("yes", "no")) %>%
droplevels()
card_features <- setdiff(colnames(card.log10), c("sample_id", "sex", "age", "abx_6months", "subject_code", "carrier", "st131_detect"))
if (nrow(card.log10) > 0) {
card.log10$carrier2 <- relevel(factor(card.log10$carrier2), ref = "non")
card.log10$st131_detect <- relevel(factor(card.log10$st131_detect), ref = "no")
lm.card.carrier2.nested <- purrr::map(
rlang::set_names(card_features),
~ fit_taxa_model(
data = card.log10 %>% drop_na(sex, age, abx_6months, subject_code),
response_col = .x,
fixed_part = "carrier2/st131_detect + sex + age + abx_6months",
random_group = "subject_code"
)
)
lm.card.carrier2.nested.df <- purrr::map_dfr(lm.card.carrier2.nested, broom.mixed::tidy, .id = "CARD") %>%
dplyr::filter(effect == "fixed") %>%
dplyr::mutate(padj = p.adjust(p.value, method = "fdr")) %>%
dplyr::select(CARD, term, estimate, std.error, statistic, df, p.value, padj)
write.csv(lm.card.carrier2.nested.df, "sigcard_carrier2_nested.csv", row.names = FALSE)
}
